<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.zavora.adk-gateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>source /Users/jameskaranja/.openclaw/env.sh &amp;&amp; exec /usr/local/bin/adk-gateway --config /Users/jameskaranja/.openclaw/openclaw.json</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jameskaranja/.openclaw</string>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/jameskaranja/.openclaw/logs/adk-gateway.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/jameskaranja/.openclaw/logs/adk-gateway.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>adk_gateway=info,adk_rust=info,tower_http=info</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/Users/jameskaranja/.cargo/bin</string>
        <key>HOME</key>
        <string>/Users/jameskaranja</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>5</integer>

    <key>ProcessType</key>
    <string>Interactive</string>
</dict>
</plist>
